@startuml pdr
' 数据流图：手机 App 的惯性位姿估计（行人航位推算 + 室外融合）与走路驾驶：走路速度驱动手机车沿服务端路线行驶，10 Hz 上报车的位姿。
!include _style.iuml
left to right direction
skinparam linetype polyline

rectangle "传感器（安卓）" as S {
  card "加速度计" as ACC
  card "陀螺仪" as GYR
  card "重力（虚拟传感器）" as GRV
  card "磁力计（室外）" as MAG
  card "卫星定位 GPS / 北斗（室外）" as GNSS
}

rectangle "core 包（纯 Java，可在电脑上测试）" as C {
  component "StepDetector\n模长 → 两级低通 → 峰谷检测\n自适应回滞" as SD
  component "Weinberg 步长\nL = K·⁴√(a_max − a_min)" as SL
  component "HeadingEstimator\nω·up 积分得航向\n静止估计零偏\n磁力计 PI 修正（室外）" as HE
  component "PdrEngine\n每步：P += L·(cosψ, sinψ)\n卫星标量卡尔曼修正（室外）\n走路速度 = L × 步频" as PE
  component "RouteFollower（手机车）\n期望车速 = 走路速度 × 驾驶比例\n沿路线推进 s ≤ stopS" as RF
  component "DwConnection\n10 Hz 上报车的 state" as DC
}

card "显示 / CSV 记录\n手机坐标系位姿" as LOG
card "服务端\npath · permit" as SRV

ACC --> SD
SD --> SL : 一步的加速度幅值
GYR --> HE
GRV --> HE : 竖直方向 up
MAG --> HE
SL --> PE : 步长 L
HE --> PE : 航向 ψ
GNSS --> PE : 经纬度 → 东北坐标
PE --> LOG : 位置 · 航向
PE --> RF : 走路速度
SRV --> RF : 路线 · 授权停车点
RF --> DC : 车的位姿 (x, y, θ, v)
@enduml
